{
    "manifest_version": 3,
    "name": "Markdown Viewer",
    "description": "Shows Markdown files (.md) as formatted pages instead of plain text.",
    "version": "1.0",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": ["background.js"],
		"persistent": false
    },

    "content_scripts": [
        {
            "js": ["detect.js"],
            "matches": ["<all_urls>"],
            "run_at": "document_end",
            "all_frames": false
        }
    ],

    "permissions": ["scripting"],
    "host_permissions": ["<all_urls>"]
}
